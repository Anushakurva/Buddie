rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return request.auth.token.email.split('@')[0]; }

    match /users/{phone} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && phone == me();
      match /contacts/{c} {
        allow read, write: if request.auth != null && phone == me();
      }
    }

    match /chats/{pair}/messages/{m} {
      allow read: if request.auth != null && pair.split('_').hasAny([me()]);
      allow create: if request.auth != null
                    && pair.split('_').hasAny([me()])
                    && request.resource.data.from == me();
    }
  }
}
